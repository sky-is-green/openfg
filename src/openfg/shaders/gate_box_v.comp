// 8x8 box filter, vertical pass, for local variance.

#version 450

#include "gate_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) readonly buffer Mean {
    float values[];
} mean;
layout(set = 0, binding = 1) readonly buffer MeanSquare {
    float values[];
} meanSquare;
layout(set = 0, binding = 2) writeonly buffer Variance {
    float values[];
} variance;

layout(push_constant) uniform Push {
    uint width;
    uint height;
} pc;

void main()
{
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(pc.width) || pixel.y >= int(pc.height))
        return;
    float sum = 0.0;
    float sumSquare = 0.0;
    for (int i = -3; i <= 4; ++i) {
        const int y = gateReflect(pixel.y + i, int(pc.height));
        const uint index = uint(y) * pc.width + uint(pixel.x);
        sum += mean.values[index];
        sumSquare += meanSquare.values[index];
    }
    const float localMean = sum / 8.0;
    variance.values[uint(pixel.y) * pc.width + uint(pixel.x)] =
        max(0.0, sumSquare / 8.0 - localMean * localMean);
}
