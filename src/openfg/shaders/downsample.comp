// 4-tap binomial downsample: a proper low-pass before decimation.
//
// A box filter leaves high-frequency texture aliased at the coarse pyramid
// levels, where block matching then locks onto the wrong peak. The [1 3 3 1]/8
// kernel is centred on the same 2x2 footprint as the old box, so the pyramid
// stays aligned, but removes the aliasing that was breaking coarse flow.
#version 460
#include "common.glsl"

layout(set = 0, binding = 8, r8) uniform image2D uIn;
layout(set = 0, binding = 9, r8) uniform image2D uOut;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dstSize = ivec2(pc.width, pc.height);
    if (any(greaterThanEqual(p, dstSize)))
        return;

    ivec2 srcSize = imageSize(uIn);
    ivec2 s = p * 2;

    const float k[4] = float[](1.0 / 8.0, 3.0 / 8.0, 3.0 / 8.0, 1.0 / 8.0);
    float sum = 0.0;
    for (int y = -1; y <= 2; y++) {
        for (int x = -1; x <= 2; x++) {
            float w = k[x + 1] * k[y + 1];
            sum += imageLoad(uIn, clampCoord(s + ivec2(x, y), srcSize)).r * w;
        }
    }

    imageStore(uOut, p, vec4(sum, 0.0, 0.0, 1.0));
}
