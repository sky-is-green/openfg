// Separable Gaussian blur, vertical pass, plus high-frequency map.

#version 450

#include "gate_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) readonly buffer Source {
    float values[];
} source;
layout(set = 0, binding = 1) readonly buffer Luma {
    float values[];
} luma;
layout(set = 0, binding = 2) writeonly buffer HighFrequency {
    float values[];
} highFrequency;

layout(push_constant) uniform Push {
    uint width;
    uint height;
    uint radius;
    uint pad;
    float weights[15];
} pc;

void main()
{
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(pc.width) || pixel.y >= int(pc.height))
        return;
    const int radius = int(pc.radius);
    float value = 0.0;
    for (int i = -radius; i <= radius; ++i) {
        const int y = gateReflect(pixel.y + i, int(pc.height));
        value += pc.weights[i + radius] *
            source.values[uint(y) * pc.width + uint(pixel.x)];
    }
    const uint index = uint(pixel.y) * pc.width + uint(pixel.x);
    highFrequency.values[index] = abs(luma.values[index] - value);
}
