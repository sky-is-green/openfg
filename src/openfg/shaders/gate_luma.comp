// RGBA8 -> luma for the gate feature pass.

#version 450

#include "gate_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) readonly buffer Source {
    uint pixels[];
} source;
layout(set = 0, binding = 1) writeonly buffer Luma {
    float values[];
} luma;

layout(push_constant) uniform Push {
    uint width;
    uint height;
} pc;

void main()
{
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(pc.width) || pixel.y >= int(pc.height))
        return;
    const uint index = uint(pixel.y) * pc.width + uint(pixel.x);
    luma.values[index] = gateLuma(gateRgb(source.pixels[index]));
}
