#version 450
#extension GL_GOOGLE_include_directive : enable

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D InputTexture;
layout(set = 0, binding = 1) uniform sampler InputSampler;
layout(set = 0, binding = 2, rgba32f) uniform image2D OutputTexture;

layout(push_constant) uniform Constants {
    uvec4 Const0;
    uvec4 Const1;
    uvec4 Const2;
    uvec4 Const3;
    uvec4 Sample;
} constants;

#define A_GPU 1
#define A_GLSL 1
#define FSR_EASU_F 1

#include "fsr1/ffx_a.h"

AF4 FsrEasuRF(AF2 p) {
    return textureGather(sampler2D(InputTexture, InputSampler), p, 0);
}
AF4 FsrEasuGF(AF2 p) {
    return textureGather(sampler2D(InputTexture, InputSampler), p, 1);
}
AF4 FsrEasuBF(AF2 p) {
    return textureGather(sampler2D(InputTexture, InputSampler), p, 2);
}

#include "fsr1/ffx_fsr1.h"

void main() {
    const ivec2 size = imageSize(OutputTexture);
    const AU2 pos = AU2(gl_GlobalInvocationID.xy);
    if (pos.x >= uint(size.x) || pos.y >= uint(size.y))
        return;
    AF3 color;
    FsrEasuF(color, pos, constants.Const0, constants.Const1,
             constants.Const2, constants.Const3);
    if (constants.Sample.x == 1)
        color *= color;
    imageStore(OutputTexture, ivec2(pos), AF4(color, 1.0));
}
