// Low-resolution gate maps: Sobel, Laplacian, colour spread and saturation.

#version 450

#include "gate_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) readonly buffer Source {
    uint pixels[];
} source;
layout(set = 0, binding = 1) readonly buffer Luma {
    float values[];
} luma;
layout(set = 0, binding = 2) writeonly buffer GradientX {
    float values[];
} gradientX;
layout(set = 0, binding = 3) writeonly buffer GradientY {
    float values[];
} gradientY;
layout(set = 0, binding = 4) writeonly buffer Gradient {
    float values[];
} gradient;
layout(set = 0, binding = 5) writeonly buffer Laplacian {
    float values[];
} laplacian;
layout(set = 0, binding = 6) writeonly buffer ColorStd {
    float values[];
} colorStd;
layout(set = 0, binding = 7) writeonly buffer Saturation {
    float values[];
} saturation;

layout(push_constant) uniform Push {
    uint width;
    uint height;
} pc;

void main()
{
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(pc.width) || pixel.y >= int(pc.height))
        return;
    const int width = int(pc.width);
    const int height = int(pc.height);

    float gx = 0.0;
    float gy = 0.0;
    float lap = 0.0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            const int sx = gateReflect(pixel.x + dx, width);
            const int sy = gateReflect(pixel.y + dy, height);
            const float value = luma.values[
                uint(sy) * pc.width + uint(sx)];
            gx += float(dx) * (2.0 - abs(float(dy))) * value;
            gy += float(dy) * (2.0 - abs(float(dx))) * value;
            const float kernel = (dx == 0 && dy == 0) ? -4.0
                : ((dx == 0 || dy == 0) ? 1.0 : 0.0);
            lap += kernel * value;
        }
    }

    const uint index = uint(pixel.y) * pc.width + uint(pixel.x);
    const vec3 color = gateRgb(source.pixels[index]);
    const float mean = (color.r + color.g + color.b) / 3.0;
    const float spread = sqrt(
        ((color.r - mean) * (color.r - mean)
        + (color.g - mean) * (color.g - mean)
        + (color.b - mean) * (color.b - mean)) / 3.0);
    const float high = max(color.r, max(color.g, color.b));
    const float low = min(color.r, min(color.g, color.b));
    const float sat = high > 1e-4 ? (high - low) / (high + 1e-4) : 0.0;

    gradientX.values[index] = gx;
    gradientY.values[index] = gy;
    gradient.values[index] = sqrt(gx * gx + gy * gy);
    laplacian.values[index] = lap;
    colorStd.values[index] = spread;
    saturation.values[index] = sat;
}
